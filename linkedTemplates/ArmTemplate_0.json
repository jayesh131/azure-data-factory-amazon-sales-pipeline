                "annotations": [],
                "type": "AzureSqlTable",
                "schema": [],
                "typeProperties": {
                    "schema": "dbo",
                    "table": "amazon_sales"
                }
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/ls_azuresql')]"
            ]
