                        "name": "ASIN",
                        "type": "String"
                    },
                    {
                        "name": "Courier Status",
                        "type": "String"
                    },
                    {
                        "name": "Qty",
                        "type": "String"
                    },
                    {
                        "name": "currency",
                        "type": "String"
                    },
                    {
                        "name": "Amount",
                        "type": "String"
                    },
                    {
                        "name": "ship-city",
                        "type": "String"
                    },
                    {
                        "name": "ship-state",
                        "type": "String"
                    },
                    {
                        "name": "ship-postal-code",
                        "type": "String"
