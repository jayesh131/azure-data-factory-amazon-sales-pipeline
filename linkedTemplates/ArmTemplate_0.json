                    "location": {
                        "type": "AzureBlobStorageLocation",
                        "fileName": "Amazon Sale Report.csv",
                        "container": "raw"
                    },
                    "columnDelimiter": ",",
                    "escapeChar": "\\",
                    "firstRowAsHeader": true,
                    "quoteChar": "\""
                },
                "schema": [
                    {
                        "name": "index",
                        "type": "String"
                    },
                    {
                        "name": "Order ID",
                        "type": "String"
                    },
                    {
                        "name": "Date",
                        "type": "String"
                    },
                    {
                        "name": "Status",
                        "type": "String"
                    },
                    {
                        "name": "Fulfilment",
                        "type": "String"
